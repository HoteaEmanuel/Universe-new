generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum AccountType {
  normal
  business
}

enum GroupVisibility {
  public
  private
}

enum GroupRole {
  member
  admin
}

enum EventVisibility {
  public
  private
}

enum EventParticipantStatus {
  going
  interested
  waitlisted
}

model User {
  id                        String                   @id @default(uuid())
  firstName                 String?
  lastName                  String?
  name                      String?
  username                  String                   @unique
  email                     String                   @unique
  password                  String?
  lastLogin                 DateTime                 @default(now())
  isVerified                Boolean                  @default(false)
  profilePicture            String?                  @default("")
  profilePictureKey         String?
  university                String?
  major                     String?
  bio                       String?
  role                      UserRole                 @default(user)
  googleId                  String?                  @unique
  accountType               AccountType              @default(normal)
  identityVerified          String                   @default("false")
  resetPasswordToken        String?
  resetPasswordExpiresAt    DateTime?
  refreshToken              String?
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts      Int                      @default(0)
  verificationCooldownUntil DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  searchVector              Unsupported("tsvector")?

  posts                 Post[]
  comments              Comment[]
  commentLikes          CommentLike[]
  likes                 Like[]
  following             Follow[]       @relation("Follower")
  followers             Follow[]       @relation("Following")
  savedPosts            SavedPost[]
  notificationsReceived Notification[] @relation("NotificationUser")
  notificationsActed    Notification[] @relation("NotificationActionUser")
  conversationsAsOne    Conversation[] @relation("ParticipantOne")
  conversationsAsTwo    Conversation[] @relation("ParticipantTwo")
  sentMessages          Message[]      @relation("SenderMessages")
  receivedMessages      Message[]      @relation("ReceiverMessages")
  groupMemberships      GroupMembers[]
  groupMessages         GroupMessage[]
  messageReactions      MessageReaction[]
  groupMessageReactions GroupMessageReaction[]
  preferences           UserPreferences?
  createdEvents         Event[]                @relation("EventCreator")
  eventParticipations   EventParticipant[]
  eventBansReceived     EventBan[]             @relation("EventBannedUser")
  eventBansIssued       EventBan[]             @relation("EventBanIssuedBy")
  groupBansReceived     GroupBan[]             @relation("GroupBannedUser")
  groupBansIssued       GroupBan[]             @relation("GroupBanIssuedBy")
  polls                 Poll[]
  pollVotes             PollVote[]
  mentionedInPosts      Post[]           @relation("PostMentions")
  mentionedInComments   Comment[]        @relation("CommentMentions")
  mentionedInGroupMessages GroupMessage[] @relation("GroupMessageMentions")

  @@index([university])
  @@map("users")
}

model UserPreferences {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("light")
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_preferences")
}

model Post {
  id              String                   @id @default(uuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imagesUrls      String[]                 @default([])
  imagesPublicIds String[]                 @default([])
  title           String
  body            String?
  location        String?
  tags            Tag[]                    @relation("PostTags")
  mentionedUsers  User[]                   @relation("PostMentions")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  searchVector    Unsupported("tsvector")?

  eventId String? @unique
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  poll Poll?

  comments Comment[]
  likes    Like[]
  savedBy  SavedPost[]
  notifications Notification[]

  sharedInMessages      Message[]
  sharedInGroupMessages GroupMessage[]

  @@index([userId])
  @@map("posts")
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  posts Post[] @relation("PostTags")

  @@map("tags")
}

model Comment {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  text         String
  likesCount   Int       @default(0)
  parentId     String?
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("CommentReplies")
  repliesCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  likes CommentLike[]
  mentionedUsers User[]       @relation("CommentMentions")
  notifications Notification[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  likedById String
  likedBy   User     @relation(fields: [likedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([commentId, likedById])
  @@map("comment_likes")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([followerId, followingId])
  @@map("follows")
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([postId])
  @@map("saved_posts")
}

model Notification {
  id             String        @id @default(uuid())
  title          String?
  userId         String?
  user           User?         @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actionUserId   String?
  actionUser     User?         @relation("NotificationActionUser", fields: [actionUserId], references: [id], onDelete: Cascade)
  type           String?
  message        String?
  read           Boolean       @default(false)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  groupId        String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  postId         String?
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userAvatar     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model Conversation {
  id                       String    @id @default(uuid())
  participantOneId         String
  participantOne           User      @relation("ParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwoId         String
  participantTwo           User      @relation("ParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  lastMessageId            String?   @unique
  lastMessage              Message?  @relation("ConversationLastMessage", fields: [lastMessageId], references: [id])
  lastReadAtParticipantOne DateTime?
  lastReadAtParticipantTwo DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  messages      Message[]      @relation("ConversationMessages")
  notifications Notification[]

  @@unique([participantOneId, participantTwoId])
  @@index([updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  senderId       String
  sender         User         @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User         @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  content        String?
  edited         Boolean      @default(false)
  deleted        Boolean      @default(false)
  imageUrls      String[]     @default([])
  imagePublicIds String[]     @default([])
  audioUrl       String?
  audioKey       String?
  audioDurationSec Int?
  sharedPostId   String?
  sharedPost     Post?        @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lastMessageOf Conversation? @relation("ConversationLastMessage")
  reactions     MessageReaction[]
  attachments   Attachment[]

  @@index([senderId, receiverId])
  @@index([conversationId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

model Group {
  id                 String                   @id @default(uuid())
  name               String
  description        String?
  coverImageUrl      String?
  coverImagePublicId String?
  visibility         GroupVisibility          @default(private)
  university         String?
  courseTag          String?
  lastMessageId      String?                  @unique
  lastMessage        GroupMessage?            @relation("GroupLastMessage", fields: [lastMessageId], references: [id])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  searchVector       Unsupported("tsvector")?

  eventId String? @unique
  event   Event?  @relation("EventCoordinationGroup", fields: [eventId], references: [id], onDelete: SetNull)

  members       GroupMembers[]
  messages      GroupMessage[] @relation("GroupMessages")
  notifications Notification[]
  hostedEvents  Event[]        @relation("GroupHostedEvents")
  bans          GroupBan[]

  @@index([university, courseTag])
  @@map("groups")
}

model GroupBan {
  id             String   @id @default(uuid())
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation("GroupBannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedByUserId String?
  bannedBy       User?    @relation("GroupBanIssuedBy", fields: [bannedByUserId], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_bans")
}

model GroupMembers {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId  String
  member    User      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      GroupRole @default(member)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([groupId, memberId])
  @@map("group_members")
}

model GroupMessage {
  id               String   @id @default(uuid())
  groupId          String
  group            Group    @relation("GroupMessages", fields: [groupId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content          String?
  imageUrls        String[] @default([])
  imagePublicIds   String[] @default([])
  audioUrl         String?
  audioKey         String?
  audioDurationSec Int?
  sharedPostId     String?
  sharedPost       Post?    @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)
  edited           Boolean  @default(false)
  deleted          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lastMessageOf Group? @relation("GroupLastMessage")
  reactions     GroupMessageReaction[]
  attachments   Attachment[]
  poll          Poll?
  mentionedUsers User[] @relation("GroupMessageMentions")

  @@index([groupId])
  @@map("group_messages")
}

model Attachment {
  id             String        @id @default(uuid())
  fileUrl        String
  fileKey        String
  fileName       String
  fileSize       Int
  mimeType       String
  createdAt      DateTime      @default(now())
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  groupMessageId String?
  groupMessage   GroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([groupMessageId])
  @@map("attachments")
}

model GroupMessageReaction {
  id             String       @id @default(uuid())
  groupMessageId String
  groupMessage   GroupMessage @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji          String
  createdAt      DateTime     @default(now())

  @@unique([groupMessageId, userId])
  @@index([groupMessageId])
  @@map("group_message_reactions")
}

model Event {
  id            String   @id @default(uuid())
  creatorId     String
  creator       User     @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  hostGroupId   String?
  hostGroup     Group?   @relation("GroupHostedEvents", fields: [hostGroupId], references: [id], onDelete: SetNull)

  title         String
  description   String?
  location      String?
  virtualUrl    String?
  coverImageUrl String?
  coverImageKey String?
  startAt       DateTime
  endAt         DateTime?
  visibility    EventVisibility          @default(public)
  capacity      Int?
  cancelledAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  searchVector  Unsupported("tsvector")?

  participants      EventParticipant[]
  announcementPost  Post?          @relation
  coordinationGroup Group?         @relation("EventCoordinationGroup")
  notifications     Notification[]
  bans              EventBan[]

  @@index([startAt])
  @@index([hostGroupId])
  @@map("events")
}

model EventParticipant {
  id        String                 @id @default(uuid())
  eventId   String
  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EventParticipantStatus @default(going)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_participants")
}

model EventBan {
  id             String   @id @default(uuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation("EventBannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedByUserId String?
  bannedBy       User?    @relation("EventBanIssuedBy", fields: [bannedByUserId], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_bans")
}

model Poll {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question  String
  closesAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime @default(now())

  postId String? @unique
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  groupMessageId String?       @unique
  groupMessage   GroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)

  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id       String @id @default(uuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text     String
  position Int

  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
  @@index([optionId])
  @@map("poll_votes")
}
